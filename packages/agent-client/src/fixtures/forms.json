{
  "about": "Shared fixture of schema-form answer checks (spec 2026-11-15, criterion 8). Each case posts `values` to the form named by `form`; `errors` lists the property ids the check refuses (empty: accepted). The TS check (packages/ui/src/lib/schemaForm) and Go inputs.CheckAnswer must give the same ids. Messages are not compared.",
  "forms": {
    "signin": {
      "type": "object",
      "required": ["email", "password"],
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "x-octo": {
            "placeholder": "you@example.com"
          }
        },
        "password": {
          "type": "string",
          "format": "password",
          "title": "Password",
          "minLength": 8
        },
        "remember": {
          "type": "boolean",
          "title": "Keep me signed in for this project",
          "default": true
        }
      }
    },
    "region": {
      "type": "object",
      "required": ["region", "env"],
      "properties": {
        "region": {
          "type": "string",
          "title": "Region",
          "oneOf": [
            {
              "const": "eu-west",
              "title": "Europe (Ireland)"
            },
            {
              "const": "eu-central",
              "title": "Europe (Frankfurt)"
            },
            {
              "const": "us-east",
              "title": "US East (Virginia)"
            },
            {
              "const": "us-west",
              "title": "US West (Oregon)"
            },
            {
              "const": "ap-south",
              "title": "Asia Pacific (Mumbai)"
            },
            {
              "const": "ap-east",
              "title": "Asia Pacific (Tokyo)"
            }
          ]
        },
        "env": {
          "type": "string",
          "title": "Environment",
          "enum": ["dev", "staging", "prod"],
          "enumNames": ["Development", "Staging", "Production"]
        }
      }
    },
    "rollout": {
      "type": "object",
      "required": ["replicas", "canary_percent"],
      "properties": {
        "replicas": {
          "type": "integer",
          "title": "Replicas",
          "minimum": 1,
          "maximum": 10,
          "x-octo": {
            "step": 1
          },
          "default": 2
        },
        "window": {
          "type": "string",
          "format": "date-time",
          "title": "Deploy window starts"
        },
        "start": {
          "type": "string",
          "format": "date",
          "title": "Freeze ends"
        },
        "notes": {
          "type": "string",
          "title": "Release notes",
          "maxLength": 200,
          "x-octo": {
            "multiline": true
          }
        },
        "slug": {
          "type": "string",
          "title": "Release name",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "canary": {
          "type": "boolean",
          "title": "Use a canary"
        },
        "canary_percent": {
          "type": "integer",
          "title": "Canary traffic (%)",
          "minimum": 1,
          "maximum": 50,
          "x-octo": {
            "visible_when": {
              "field": "canary",
              "equals": true
            }
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "title": "Checks",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "anyOf": [
              {
                "const": "unit",
                "title": "Unit tests"
              },
              {
                "const": "lint",
                "title": "Lint"
              },
              {
                "const": "e2e",
                "title": "End-to-end"
              },
              {
                "const": "types",
                "title": "Type check"
              }
            ]
          }
        },
        "regions": {
          "type": "array",
          "title": "Regions",
          "items": {
            "type": "string",
            "enum": ["eu-west", "eu-central", "us-east", "us-west", "ap-south", "ap-east", "sa-east", "af-south"]
          }
        }
      }
    },
    "accept": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "title": "I understand the tests write to staging",
          "x-octo": {
            "accept": true
          }
        }
      }
    },
    "site": {
      "type": "object",
      "required": ["env", "tier"],
      "properties": {
        "env": {
          "type": "string",
          "title": "Environment",
          "enum": ["dev", "staging", "prod"]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "title": "Health check address"
        },
        "tier": {
          "type": "string",
          "title": "Tier",
          "enum": ["small", "large"],
          "x-octo": {
            "visible_when": {
              "field": "env",
              "equals": ["staging", "prod"]
            }
          }
        }
      }
    }
  },
  "cases": [
