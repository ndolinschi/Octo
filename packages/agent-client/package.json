{
  "name": "@octo/agent-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fileBytes": "./src/fileBytes.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint .",
    "test": "node --import tsx --test src/*.test.ts",
    "format:check": "prettier --check --ignore-path ../../.prettierignore \"src/**/*.ts\" \"*.json\"",
    "format": "prettier --write --ignore-path ../../.prettierignore \"src/**/*.ts\" \"*.json\""
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "typescript": "~6.0.3"
  }
}
