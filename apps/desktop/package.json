{
  "name": "@octo/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "sidecar": "bash ../../scripts/build-sidecar.sh",
    "tauri": "tauri",
    "lint": "tsc --noEmit && eslint .",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "format:check": "prettier --check --ignore-path ../../.prettierignore \"src/**/*.{ts,tsx,css}\" \"*.json\" \"*.ts\"",
    "format": "prettier --write --ignore-path ../../.prettierignore \"src/**/*.{ts,tsx,css}\" \"*.json\" \"*.ts\""
  },
  "dependencies": {
    "@octo/agent-client": "workspace:*",
    "@octo/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
