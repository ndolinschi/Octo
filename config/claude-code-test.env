# Claude Code → Octo proxy → OpenRouter (source in this shell, then: claude)
#
# 1. In repo root: cargo run   (loads config/)
# 401 "x-api-key header is required" → Octo was on [llm.messages] backend=claude without
# Bearer→x-api-key mapping, or ANTHROPIC_AUTH_TOKEN unset. Restart `cargo run` after config change.
# 3. export OPENROUTER_API_KEY=... && source config/claude-code-test.env && claude

export OPENROUTER_API_KEY="${OPENROUTER_API_KEY:?set OPENROUTER_API_KEY first}"

# Octo speaks Anthropic Messages on /v1/messages (forwards Bearer to OpenRouter).
export ANTHROPIC_BASE_URL="http://127.0.0.1:8080"
export ANTHROPIC_AUTH_TOKEN="$OPENROUTER_API_KEY"
export ANTHROPIC_API_KEY=""

export ANTHROPIC_DEFAULT_HAIKU_MODEL="google/gemma-4-26b-a4b-it"
export ANTHROPIC_DEFAULT_SONNET_MODEL="deepseek/deepseek-v4-flash"
export ANTHROPIC_DEFAULT_OPUS_MODEL="~anthropic/claude-haiku-latest"
export CLAUDE_CODE_SUBAGENT_MODEL="google/gemma-4-26b-a4b-it"
