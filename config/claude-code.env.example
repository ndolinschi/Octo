# Claude Code → OpenRouter (via Octo or direct)
#
# Copy to your shell profile or `source` before `claude`.
# Octo must use OpenRouter for Messages: set `[llm.messages] backend = "openrouter"`
# in config/llm.toml (or POST /openrouter/v1/messages).
#
# --- Through local Octo (repo root: cargo run) ---
export ANTHROPIC_BASE_URL="http://127.0.0.1:8080"
export ANTHROPIC_AUTH_TOKEN="${OPENROUTER_API_KEY:?set OPENROUTER_API_KEY}"
export ANTHROPIC_API_KEY=""
#
# --- Or direct to OpenRouter (no Octo) ---
# export ANTHROPIC_BASE_URL="https://openrouter.ai/api"
# export ANTHROPIC_AUTH_TOKEN="${OPENROUTER_API_KEY:?set OPENROUTER_API_KEY}"
# export ANTHROPIC_API_KEY=""

# Cheap model tiers (OpenRouter slugs in request bodies).
# Haiku slot  → smallest / fastest (Gemma 4 26B A4B)
export ANTHROPIC_DEFAULT_HAIKU_MODEL="google/gemma-4-26b-a4b-it"
# Sonnet slot → daily coding (DeepSeek Flash)
export ANTHROPIC_DEFAULT_SONNET_MODEL="deepseek/deepseek-v4-flash"
# Opus slot   → still cheap: real Haiku latest (not full Opus)
export ANTHROPIC_DEFAULT_OPUS_MODEL="~anthropic/claude-haiku-latest"
# Sub-agents  → same as Haiku slot
export CLAUDE_CODE_SUBAGENT_MODEL="google/gemma-4-26b-a4b-it"

# Optional: OpenRouter provider preference (Claude Code + Anthropic skin)
# export OPENROUTER_PROVIDER="Anthropic"
