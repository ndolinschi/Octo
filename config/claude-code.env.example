# Prefer repo-root `.env` (see `.env.example`) + `source scripts/claude-code-env.sh`.
# This file is a manual `source` fallback with the same Mistral defaults.
# ANTHROPIC_BASE_URL must be an API root (Claude Code appends /v1/messages).
# If Claude Code shows Anthropic "API Usage Billing", you are not hitting OpenRouter/Octo.
#
# Auth: ANTHROPIC_AUTH_TOKEN only — unset ANTHROPIC_API_KEY (empty still counts as set).

# --- Through local Octo /autoroute (recommended for experiments) ---
export ANTHROPIC_BASE_URL="http://127.0.0.1:8080/autoroute"
export ANTHROPIC_AUTH_TOKEN="${OPENROUTER_API_KEY:?set OPENROUTER_API_KEY in .env}"
unset ANTHROPIC_API_KEY

# Mistral ladder ↔ Claude Code slots (matches config/autoroute.toml).
# Claude Code may warn that the slug is unrecognized — that is expected for OpenRouter.
export ANTHROPIC_DEFAULT_HAIKU_MODEL="mistralai/ministral-8b-2512"
export ANTHROPIC_DEFAULT_SONNET_MODEL="mistralai/mistral-small-3.1-24b-instruct"
export ANTHROPIC_DEFAULT_OPUS_MODEL="mistralai/devstral-2512"
export CLAUDE_CODE_SUBAGENT_MODEL="mistralai/ministral-8b-2512"

# --- Plain Octo OpenRouter Messages (no autoroute) ---
# export ANTHROPIC_BASE_URL="http://127.0.0.1:8080/openrouter"
# export ANTHROPIC_AUTH_TOKEN="${OPENROUTER_API_KEY:?set OPENROUTER_API_KEY}"
# unset ANTHROPIC_API_KEY

# --- Direct OpenRouter (skip Octo) ---
# export ANTHROPIC_BASE_URL="https://openrouter.ai/api"
# export ANTHROPIC_AUTH_TOKEN="${OPENROUTER_API_KEY:?set OPENROUTER_API_KEY}"
# unset ANTHROPIC_API_KEY
