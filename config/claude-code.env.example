# Prefer repo-root .env (gitignored) — do not paste keys here.
#
#   cp .env.example .env
#   # edit .env → OPENROUTER_API_KEY=...
#   source scripts/claude-code-env.sh
#   ./scripts/claude-code-experiment.sh
#
# scripts/claude-code-env.sh sources .env (and optional experiments/.env)
# then sets ANTHROPIC_* for Octo /autoroute + Mistral tiers.

export ANTHROPIC_BASE_URL="http://127.0.0.1:8080/autoroute"
export ANTHROPIC_AUTH_TOKEN="${OPENROUTER_API_KEY:?set OPENROUTER_API_KEY in .env}"
export ANTHROPIC_API_KEY=""

export ANTHROPIC_DEFAULT_HAIKU_MODEL="mistralai/ministral-8b-2512"
export ANTHROPIC_DEFAULT_SONNET_MODEL="mistralai/mistral-small-3.1-24b-instruct"
export ANTHROPIC_DEFAULT_OPUS_MODEL="mistralai/devstral-2512"
export CLAUDE_CODE_SUBAGENT_MODEL="mistralai/ministral-8b-2512"
