# Claude Code → Octo /autoroute (Mistral tiers)
#
# Preferred: source the script (loads experiments/.env if present):
#   export OPENROUTER_API_KEY="sk-or-v1-..."
#   source scripts/claude-code-env.sh
#   cd experiments && claude
#
# Or experiment helper:
#   ./scripts/claude-code-experiment.sh
#   ./scripts/claude-code-experiment.sh -p "Только чтение. …"
#
# Octo must use OpenRouter for Messages ([llm.messages] backend = openrouter).

export ANTHROPIC_BASE_URL="http://127.0.0.1:8080/autoroute"
export ANTHROPIC_AUTH_TOKEN="${OPENROUTER_API_KEY:?set OPENROUTER_API_KEY}"
export ANTHROPIC_API_KEY=""

# Map Claude Code slots → autoroute bands (see config/autoroute.toml).
export ANTHROPIC_DEFAULT_HAIKU_MODEL="mistralai/ministral-8b-2512"
export ANTHROPIC_DEFAULT_SONNET_MODEL="mistralai/mistral-small-3.1-24b-instruct"
export ANTHROPIC_DEFAULT_OPUS_MODEL="mistralai/devstral-2512"
export CLAUDE_CODE_SUBAGENT_MODEL="mistralai/ministral-8b-2512"
