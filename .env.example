# Copy to .env (gitignored), then: source scripts/claude-code-env.sh
#
# Claude Code → local Octo /autoroute (Mistral ladder).
# Values here are preferred over the script defaults when present.
# ANTHROPIC_BASE_URL must be an API root (Claude Code appends /v1/messages).
#
# Auth: use ANTHROPIC_AUTH_TOKEN only (OpenRouter/Octo).
# Do NOT set ANTHROPIC_API_KEY — even empty triggers a Claude Code warning.
# Leave ANTHROPIC_AUTH_TOKEN empty to copy OPENROUTER_API_KEY (script fills it).

OPENROUTER_API_KEY=sk-or-v1-...

# Through local Octo /autoroute (recommended for experiments).
ANTHROPIC_BASE_URL=http://127.0.0.1:8080/autoroute
ANTHROPIC_AUTH_TOKEN=

# Mistral ladder ↔ Claude Code slots (matches config/autoroute.toml).
# Unknown-slug warning from Claude Code is expected for OpenRouter models.
ANTHROPIC_DEFAULT_HAIKU_MODEL=mistralai/ministral-8b-2512
ANTHROPIC_DEFAULT_SONNET_MODEL=mistralai/mistral-small-3.1-24b-instruct
ANTHROPIC_DEFAULT_OPUS_MODEL=mistralai/devstral-2512
CLAUDE_CODE_SUBAGENT_MODEL=mistralai/ministral-8b-2512

# --- Alternatives (uncomment one block; comment out /autoroute above) ---
# Plain Octo OpenRouter Messages (no autoroute):
# ANTHROPIC_BASE_URL=http://127.0.0.1:8080/openrouter
# ANTHROPIC_AUTH_TOKEN=

# Direct OpenRouter (skip Octo):
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=
